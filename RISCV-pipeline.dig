      <elementName>External</elementName>
      <elementAttributes>
        <entry>
          <string>applicationType</string>
          <appType>GHDL</appType>
        </entry>
        <entry>
          <string>Label</string>
          <string>MUX_2inputs</string>
        </entry>
        <entry>
          <string>externalInputs</string>
          <string>enter1:32,enter2:32,selector</string>
        </entry>
        <entry>
          <string>Code</string>
          <string>LIBRARY ieee;
USE ieee.std_logic_1164.all;

ENTITY MUX_2inputs IS
	PORT(
		enter1, enter2 : IN STD_LOGIC_VECTOR (31 downto 0);
		selector : IN STD_LOGIC;
		output : OUT STD_LOGIC_VECTOR (31 downto 0)
	);
END MUX_2inputs;

ARCHITECTURE MUX_logic OF MUX_2inputs IS
	BEGIN
		output &lt;= enter1 WHEN selector = &apos;0&apos; ELSE
			enter2;

	END MUX_logic;
--------------------------------------------------------------------------------</string>
