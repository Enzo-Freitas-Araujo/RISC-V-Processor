    </visualElement>
    <visualElement>
      <elementName>Ground</elementName>
      <elementAttributes/>
      <pos x="140" y="2420"/>
    </visualElement>
    <visualElement>
      <elementName>External</elementName>
      <elementAttributes>
        <entry>
          <string>applicationType</string>
          <appType>GHDL</appType>
        </entry>
        <entry>
          <string>Label</string>
          <string>ALU_control</string>
        </entry>
        <entry>
          <string>externalInputs</string>
          <string>instruction:32,ALUOp:2</string>
        </entry>
        <entry>
          <string>Code</string>
          <string>LIBRARY ieee;
USE ieee.std_logic_1164.all;

ENTITY ALU_control IS
	PORT(
		instruction : IN  STD_LOGIC_VECTOR(31 downto 0);
		ALUOp  : IN STD_LOGIC_VECTOR(1 downto 0);
		selector : OUT STD_LOGIC_VECTOR(2 downto 0)
	);
END ALU_control;

ARCHITECTURE behavioral OF ALU_control IS
	SIGNAL opcode : STD_LOGIC_VECTOR(6 downto 0);
	SIGNAL funct3 : STD_LOGIC_VECTOR(14 downto 12);
	SIGNAL funct7 : STD_LOGIC_VECTOR(31 downto 25);
BEGIN

	opcode &lt;= instruction(6 downto 0);
	funct3 &lt;= instruction(14 downto 12);
	funct7 &lt;= instruction(31 downto 25);

	PROCESS(ALUOp, opcode, funct3, funct7)
		BEGIN
			selector &lt;= &quot;000&quot;;
			IF(ALUOp = &quot;00&quot; OR opcode = &quot;0000011&quot; OR opcode = &quot;0100011&quot;) THEN
				selector &lt;= &quot;000&quot;;
			ELSIF(ALUOp = &quot;01&quot; OR opcode = &quot;1100011&quot;) THEN
				selector &lt;= &quot;001&quot;;
			ELSE
				IF(opcode = &quot;0110011&quot; OR opcode = &quot;0010011&quot;) THEN
					IF(funct7 = &quot;0000000&quot; OR opcode = &quot;0010011&quot;) THEN
						IF(funct3 = &quot;000&quot;) THEN
							selector &lt;= &quot;000&quot;;
						ELSIF(funct3 = &quot;111&quot;) THEN
							selector &lt;= &quot;010&quot;;
						ELSIF(funct3 = &quot;110&quot;) THEN
							selector &lt;= &quot;011&quot;;
						ELSIF(funct3 = &quot;100&quot;) THEN
							selector &lt;= &quot;100&quot;;
						ELSIF(funct3 = &quot;001&quot;) THEN
							selector &lt;= &quot;101&quot;;
						ELSIF(funct3 = &quot;101&quot;) THEN
							selector &lt;= &quot;110&quot;;
						END IF;
					ELSIF(funct7 = &quot;0100000&quot;) THEN
						selector &lt;= &quot;001&quot;;
					END IF;
				ELSIF(opcode = &quot;0010111&quot;) THEN
					selector &lt;= &quot;111&quot;;
				END IF;
			END IF;
		END PROCESS;
END behavioral;</string>
        </entry>
        <entry>
          <string>externalOutputs</string>
          <string>selector:3</string>
        </entry>
