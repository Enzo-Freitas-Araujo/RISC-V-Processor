        </entry>
        <entry>
          <string>Code</string>
          <string>LIBRARY ieee;
USE ieee.std_logic_1164.all;

ENTITY MUX_3inputs IS
	PORT(
		enter1, enter2, enter3 : IN STD_LOGIC_VECTOR (31 downto 0);
		selector: IN STD_LOGIC_VECTOR (1 downto 0);
		output : OUT STD_LOGIC_VECTOR (31 downto 0)
	);
END MUX_3inputs;

ARCHITECTURE MUX_logic OF MUX_3inputs IS
	BEGIN
		output &lt;= enter1 WHEN selector = &quot;00&quot; ELSE
			enter2 WHEN selector = &quot;01&quot; ELSE
			enter3;

	END MUX_logic;
--------------------------------------------------------------------------------</string>
        </entry>
        <entry>
          <string>externalOutputs</string>
          <string>output:32</string>
        </entry>
      </elementAttributes>
      <pos x="880" y="980"/>
    </visualElement>
    <visualElement>
      <elementName>External</elementName>
      <elementAttributes>
        <entry>
          <string>applicationType</string>
          <appType>GHDL</appType>
        </entry>
        <entry>
          <string>Label</string>
          <string>ALU</string>
        </entry>
        <entry>
          <string>externalInputs</string>
          <string>A:32,B:32,selector:2</string>
        </entry>
        <entry>
          <string>Code</string>
          <string>LIBRARY ieee;
USE ieee.std_logic_1164.all;
USE ieee.numeric_std.all;

ENTITY ALU IS
	PORT(
		A, B : IN STD_LOGIC_VECTOR(31 downto 0);
		selector : IN STD_LOGIC_VECTOR(1 downto 0);
        	Zero    : OUT STD_LOGIC;
		Result : OUT STD_LOGIC_VECTOR(31 downto 0)
	);
END ALU;

ARCHITECTURE ALU_logic OF ALU IS

	signal B_eff    : STD_LOGIC_VECTOR(31 downto 0);

	constant allZero : std_logic_vector(31 downto 0) := (others =&gt; &apos;0&apos;);
	constant allOne : std_logic_vector(31 downto 0) := (others =&gt; &apos;1&apos;);

    	signal Sum_ext  : UNSIGNED(32 downto 0);

    	signal Res_temp : STD_LOGIC_VECTOR(31 downto 0);
	signal and_temp : STD_LOGIC_VECTOR(31 downto 0);
	signal or_temp : STD_LOGIC_VECTOR(31 downto 0);

    	signal Cin_vec  : UNSIGNED(32 downto 0);

	BEGIN

		and_temp &lt;= A AND B;
		or_temp &lt;= A OR B;

------------------------------------

    B_eff &lt;= (B xor allOne) WHEN (selector = &quot;01&quot;) ELSE
		B;

    Cin_vec &lt;= unsigned(allZero &amp; selector(0));

    Sum_ext &lt;= unsigned(&apos;0&apos; &amp; A) + unsigned(&apos;0&apos; &amp; B_eff) + Cin_vec;

    Res_temp &lt;= std_logic_vector(Sum_ext(31 downto 0));

    Zero &lt;= &apos;1&apos; WHEN ((Res_temp = allZero) AND (selector(1) = &apos;0&apos;)) ELSE
		&apos;0&apos;;

    Result &lt;= and_temp WHEN (selector = &quot;10&quot;) ELSE
		or_temp WHEN (selector = &quot;11&quot;) ELSE
		Res_temp;

	END ALU_logic;</string>
        </entry>
        <entry>
          <string>externalOutputs</string>
          <string>Zero,Result:32</string>
        </entry>
      </elementAttributes>
      <pos x="1080" y="920"/>
    </visualElement>
    <visualElement>
