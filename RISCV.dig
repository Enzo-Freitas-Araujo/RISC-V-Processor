        <entry>
          <string>Code</string>
          <string>LIBRARY ieee;
USE ieee.std_logic_1164.all;
USE ieee.numeric_std.all;

ENTITY output_control IS
	PORT(
		opcode : IN STD_LOGIC_VECTOR(6 downto 0);
		IRWrite : OUT STD_LOGIC;
		MemtoReg : OUT STD_LOGIC;
		MemWrite : OUT STD_LOGIC;
		MemRead : OUT STD_LOGIC;
		IorD : OUT STD_LOGIC;
		PCWrite : OUT STD_LOGIC;
		PCWriteCond : OUT STD_LOGIC;
		PCSource : OUT STD_LOGIC;
		ALUOp : OUT STD_LOGIC;
		ALUSrcB : OUT STD_LOGIC_VECTOR (1 downto 0);
		ALUSrcA : OUT STD_LOGIC;
		RegWrite : OUT STD_LOGIC
	);
END output_control;

ARCHITECTURE output_control_logic OF output_control IS

	CONSTANT opAritmetica : STD_LOGIC_VECTOR(6 downto 0) := &quot;0110011&quot;;
	CONSTANT opAritmeticaImm : STD_LOGIC_VECTOR(6 downto 0) := &quot;0010011&quot;;
	CONSTANT LW : STD_LOGIC_VECTOR(6 downto 0) := &quot;0000011&quot;;
	CONSTANT SW : STD_LOGIC_VECTOR(6 downto 0) := &quot;0100011&quot;;
	CONSTANT LUI : STD_LOGIC_VECTOR(6 downto 0) := &quot;0110111&quot;;
	CONSTANT AUIPC : STD_LOGIC_VECTOR(6 downto 0) := &quot;0010111&quot;;
	CONSTANT JALR : STD_LOGIC_VECTOR(6 downto 0) := &quot;1100111&quot;;
	CONSTANT JAL : STD_LOGIC_VECTOR(6 downto 0) := &quot;1101111&quot;;
	CONSTANT BRANCH : STD_LOGIC_VECTOR(6 downto 0) := &quot;1100111&quot;;

	BEGIN
		RegWrite &lt;= &apos;1&apos; WHEN (opcode = opAritmetica OR opcode = opAritmeticaImm
			OR opcode = LW OR opcode = LUI OR opcode = JALR OR opcode = JAL) ELSE
			    &apos;0&apos;;

		ALUSrcA &lt;= &apos;1&apos; WHEN (opcode = opAritmetica OR opcode = opAritmeticaImm
			OR opcode = LW OR opcode = SW OR opcode = LUI OR opcode = BRANCH) ELSE
			    &apos;0&apos;;

		ALUSrcB &lt;= &quot;00&quot; WHEN (opcode = opAritmetica OR opcode = BRANCH) ELSE
			    &quot;10&quot; WHEN (opcode = opAritmeticaImm OR opcode = LW OR 
				opcode = LW OR opcode = LUI OR opcode = AUIPC OR opcode = JAL
				OR opcode = JALR) ELSE 
				&quot;01&quot;;

	END output_control_logic;</string>
