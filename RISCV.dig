          <string>Code</string>
          <string>LIBRARY ieee;
USE ieee.std_logic_1164.all;
USE ieee.numeric_std.all;

ENTITY memory_register IS
	PORT(
		memData : IN STD_LOGIC_VECTOR(31 downto 0);
		CLK : IN STD_LOGIC;
		memOutput : OUT STD_LOGIC_VECTOR(31 downto 0)
	);
END memory_register;

ARCHITECTURE memory_register_logic OF memory_register IS
	BEGIN
	
		PROCESS(CLK)
			BEGIN
				IF (CLK&apos;event AND CLK=&apos;1&apos;) THEN
					memOutput &lt;= memData;
				ELSE
					memOutput &lt;= memOutput;
				END IF;
		END PROCESS;

	END memory_register_logic;</string>
