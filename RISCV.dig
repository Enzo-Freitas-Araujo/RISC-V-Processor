          <string>memData:32,CLK</string>
        </entry>
        <entry>
          <string>Code</string>
          <string>LIBRARY ieee;
USE ieee.std_logic_1164.all;
USE ieee.numeric_std.all;

ENTITY reg32 IS
	PORT(
		memData : IN STD_LOGIC_VECTOR(31 downto 0);
		CLK : IN STD_LOGIC;
		memOutput : OUT STD_LOGIC_VECTOR(31 downto 0)
	);
END reg32;

ARCHITECTURE reg32_logic OF reg32 IS
	BEGIN
	
		PROCESS(CLK)
			BEGIN
				IF (RISING_EDGE(CLK)) THEN
					memOutput &lt;= memData;
				ELSE
					memOutput &lt;= memOutput;
				END IF;
		END PROCESS;

	END reg32_logic;</string>
        </entry>
        <entry>
          <string>externalOutputs</string>
          <string>memOutput:32</string>
        </entry>
      </elementAttributes>
      <pos x="340" y="1140"/>
    </visualElement>
    <visualElement>
      <elementName>External</elementName>
      <elementAttributes>
        <entry>
          <string>applicationType</string>
          <appType>GHDL</appType>
        </entry>
        <entry>
          <string>Label</string>
